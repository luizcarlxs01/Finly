# Variáveis de ambiente para o Docker Compose local
# Copie este arquivo para docker/.env e preencha os valores antes de rodar.
# O arquivo .env NUNCA deve ser commitado (já está no .gitignore).

# Senha do SQL Server — deve ter letras maiúsculas, minúsculas, números e símbolo
SA_PASSWORD=SuaSenhaForte@123

# Chave JWT — gere com: openssl rand -base64 32
JWT__SecretKey=

# Chave da API do Resend (https://resend.com) — usada para enviar o código de
# verificação de e-mail no cadastro/primeiro login. Grátis até 3.000 e-mails/mês.
Resend__ApiKey=

# Remetente dos e-mails. O domínio finly.systems já está verificado no Resend
# (DKIM/SPF/DMARC configurados) — use um endereço desse domínio.
# Fallback antes da verificação: Finly <onboarding@resend.dev> (só entrega para
# o e-mail da própria conta Resend).
Resend__FromEmail=Finly <naoresponda@finly.systems>

# E-mail com acesso à área de moderação do fórum (aprovar/ocultar tópicos,
# responder). Precisa bater exatamente com o e-mail da conta logada.
Admin__Email=

# Domínio público da API, usado nas labels do Traefik (roteamento + Let's Encrypt).
# Na VPS: api.finly.systems
# Localmente o Traefik não roda, mas a variável precisa existir para o Compose
# não emitir warning de interpolação.
API_DOMAIN=api.finly.systems

# Ambiente do ASP.NET Core. O compose usa ${ASPNETCORE_ENVIRONMENT:-Production},
# ou seja, o default já é Production.
#
#   VPS / produção  → deixe COMENTADA ou ausente (cai no default Production).
#                     Production ativa: CORS só para app.finly.systems, Swagger off
#                     e UseHttpsRedirection (seguro atrás do Traefik, que envia
#                     X-Forwarded-Proto).
#
#   Dev local       → descomente como Development. Sem isso, o compose local
#                     sobe em Production e o UseHttpsRedirection redireciona
#                     http://localhost:8080 para HTTPS sem certificado, além de
#                     bloquear o CORS do localhost:3000 e esconder o Swagger.
#
#ASPNETCORE_ENVIRONMENT=Development
